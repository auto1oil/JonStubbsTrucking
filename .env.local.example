# Copy this file to .env.local and fill in your values.
# In production these are set as Vercel environment variables.

# ── Supabase ────────────────────────────────────────────────────────────────
# Settings → API in your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only. Bypasses RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ─────────────────────────────────────────────────────────────────────
# Your deployed URL. Used to build QuickBooks redirects and share links.
NEXT_PUBLIC_SITE_URL=https://jon-stubbs-trucking.vercel.app
# Any long random string. Cron routes reject requests without it.
CRON_SECRET=change-me-to-something-long-and-random

# ── Web push ────────────────────────────────────────────────────────────────
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dispatch@example.com

# ── Test tab: Trane Engineering's own QuickBooks (sandbox by default) ─────
# Optional. Sandbox companies take the Intuit app's Development keys; set
# them here if the main QUICKBOOKS_* keys are the Production ones. The
# redirect URI defaults to NEXT_PUBLIC_SITE_URL + /api/test/quickbooks/callback
# and must be added to the Intuit app.
TEST_QUICKBOOKS_CLIENT_ID=
TEST_QUICKBOOKS_CLIENT_SECRET=
TEST_QUICKBOOKS_ENVIRONMENT=sandbox

# ── Scanning (fleet paperwork) ──────────────────────────────────────────────
# Reads registrations, receipts, bills and service invoices into the forms.
# From console.anthropic.com → API keys. Server-only; without it the Scan
# buttons say scanning isn't set up.
ANTHROPIC_API_KEY=

# ── QuickBooks Online ───────────────────────────────────────────────────────
# From your app at developer.intuit.com. The redirect URI must match exactly.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://jon-stubbs-trucking.vercel.app/api/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=production
